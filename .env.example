# Copy to .env.local and fill in. Never commit real values.

# Postgres (default: project-local cluster started by `npm run db:start`)
DATABASE_URL=postgres://baton@localhost:54329/baton

# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Nexconn Console → Key Management (https://console.nexconn.ai/agile/apps/km)
# App Key is public (it ships to the browser); App Secret is server-only.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Data center chosen when the app was created: SG | NA | SA
NEXCONN_DATA_CENTER=SG

# Public URL used in QR codes (optional; defaults to the request origin)
PUBLIC_BASE_URL=
