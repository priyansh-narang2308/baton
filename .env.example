# Copy to .env.local and fill in. Never commit real values.

# --- Database -------------------------------------------------------------
# Postgres. Default: the project-local cluster started by `npm run db:start`.
DATABASE_URL=postgres://baton@localhost:54329/baton
# Optional: a direct (non-pooled) URL for migrations, e.g. Neon's unpooled URL.
# DATABASE_URL_UNPOOLED=

# --- Sessions -------------------------------------------------------------
# 32+ random characters, e.g. `openssl rand -base64 48`. Signs session cookies.
SESSION_SECRET=

# --- Nexconn --------------------------------------------------------------
# Nexconn Console → Key Management (https://console.nexconn.ai/agile/apps/km)
# App Key is public (it ships to the browser). App Secret is server-only.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Data center chosen when the app was created: SG | NA | SA
NEXCONN_DATA_CENTER=SG

# --- Optional -------------------------------------------------------------
# Public URL used in QR codes and links. Defaults to the request origin.
PUBLIC_BASE_URL=
# Set to 1 on serverless hosts (Vercel): disables the in-process worker loops.
# Escalation then runs after /state polls instead.
# BATON_DISABLE_WORKER=1
# Tests only: database used by `npm test`.
# TEST_DATABASE_URL=postgres://baton@localhost:54329/baton_test

# --- Public traction page (/traction) ----------------------------------------
# Enables the protected admin area at /traction/admin (Console snapshots, pilot verification, feedback).
# 32+ random characters, e.g. `openssl rand -base64 36`. Leave blank to disable the admin area.
TRACTION_ADMIN_TOKEN=
# Development only: 1 allows /traction?sample=1 (clearly marked sample data). Never set in production.
# TRACTION_SAMPLE_DATA=1
